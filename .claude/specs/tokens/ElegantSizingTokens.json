{
  "primitive": {
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "24": "6rem",
      "32": "8rem"
    },
    "radius": {
      "none": "0",
      "sm": "2px",
      "md": "4px"
    }
  },
  "semantic": {
    "layout": {
      "page-gutter": "var(--primitive-scale-6)",
      "section-gap": "var(--primitive-scale-24)",
      "max-width": "1280px"
    },
    "component": {
      "card-gap": "var(--primitive-scale-4)",
      "stack-gap": "var(--primitive-scale-8)",
      "tag-gap": "var(--primitive-scale-3)"
    },
    "typography": {
      "heading-to-sub": "var(--primitive-scale-3)",
      "heading-to-body": "var(--primitive-scale-4)",
      "body-to-body": "var(--primitive-scale-2)",
      "h4-to-body": "var(--primitive-scale-2)",
      "body-to-button": "var(--primitive-scale-6)",
      "label-to-description": "var(--primitive-scale-1)"
    },
    "button": {
      "px": "var(--primitive-scale-4)",
      "py": "var(--primitive-scale-2)",
      "px-sm": "var(--primitive-scale-3)",
      "py-sm": "var(--primitive-scale-1)",
      "icon-gap": "var(--primitive-scale-2)",
      "icon-gap-sm": "var(--primitive-scale-1)",
      "radius": "var(--primitive-radius-md)"
    },
    "card": {
      "padding": "var(--primitive-scale-6)",
      "radius": "var(--primitive-radius-md)"
    }
  }
}
